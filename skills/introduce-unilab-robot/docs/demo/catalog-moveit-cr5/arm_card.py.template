"""MoveIt 机械臂卡片（Device Card）薄包装：OS AST 扫描 @action；逻辑在 template mixin。"""
from __future__ import annotations

import math
from typing import Any

from unilab_arm_cr5 import MODEL_DESCRIPTOR
from unilabos.registry.annotations import JSONValue
from unilabos.registry.decorators import action
from unilab_robot_runtime.device_card import ArmCardContext, RailMountedArmCardMixin
from unilab_robot_runtime.device_card.manual_motion import _quaternion_to_euler_xyz_degrees

from {domain_pkg}.devices.{device_id}.moveit_commissioning import (
    COMMISSIONING_MOTION_PROFILE_REF,
    robot_point_set_resolver,
)
from {domain_pkg}.robot_cell.point_set_v3 import ASSET_ROOT, placeholder_tool

_RAIL_DEVICE_ID = "{rail_id}"


def build_{device_id}_arm_card_context() -> ArmCardContext:
    def catalog_entries(port: object) -> list[Any]:
        catalog = getattr(port, "commissioning_target_catalog", None)
        if catalog is not None:
            return list(catalog)
        return list(robot_point_set_resolver().authoring_catalog())

    def project_target(entry: object) -> dict[str, object]:
        joint_positions_si = tuple(
            float(value) for value in getattr(entry, "joint_positions_si", ())
        )
        target_pose = MODEL_DESCRIPTOR.forward_kinematics(
            joint_positions_si,
            placeholder_tool(),
        )
        target_ref = str(getattr(entry, "target_ref", ""))
        source_point = str(getattr(entry, "source_point", "")).strip()
        rail_position_si = getattr(entry, "rail_position_si", None)
        return {
            "target_ref": target_ref,
            "source_point": source_point or _display_source_point(target_ref),
            "kind": str(getattr(entry, "kind", "")),
            "editable": bool(getattr(entry, "editable", False)),
            "joint_positions_deg": [math.degrees(value) for value in joint_positions_si],
            "rail_position_mm": (
                float(rail_position_si) * 1000.0
                if rail_position_si is not None
                else None
            ),
            "group_ref": str(getattr(entry, "group_ref", "")),
            "tcp_pose": {
                "frame_ref": str(target_pose.frame_ref),
                "xyz_mm": [float(value) * 1000.0 for value in target_pose.xyz_m],
                "rotation_xyz_deg": list(
                    _quaternion_to_euler_xyz_degrees(target_pose.orientation_xyzw)
                ),
            },
        }

    def rail_snapshot(_binding: object, _port: object) -> tuple[dict[str, float] | None, object | None]:
        try:
            from unilab_rail_linear import MODEL_DESCRIPTOR as RAIL_MODEL

            from {domain_pkg}.devices.rail_simulation import require_rail_simulation_axis

            rail_axis = require_rail_simulation_axis(_RAIL_DEVICE_ID)
        except RuntimeError:
            return None, None
        _joint_names, rail_positions = rail_axis.joint_state_frame()
        if not rail_positions:
            return None, rail_axis
        return (
            {
                "position_mm": float(rail_positions[0]) * 1000.0,
                "travel_min_mm": float(RAIL_MODEL.travel_m[0]) * 1000.0,
                "travel_max_mm": float(RAIL_MODEL.travel_m[1]) * 1000.0,
            },
            rail_axis,
        )

    def move_rail(_binding: object, position_mm: float) -> dict[str, object]:
        from {domain_pkg}.devices.rail_simulation import require_rail_simulation_axis

        rail_axis = require_rail_simulation_axis(_RAIL_DEVICE_ID)
        rail_axis.move_to_si(float(position_mm) / 1000.0)
        return {"success": True, "position_mm": float(position_mm)}

    def motion_profile_ref(port: object) -> str:
        configured = str(getattr(port, "commissioning_motion_profile_ref", "")).strip()
        if configured:
            return configured
        return COMMISSIONING_MOTION_PROFILE_REF

    point_set_path = ASSET_ROOT / "point_sets" / "{point_set_basename}.v3.yaml"

    return ArmCardContext(
        boot_id_prefix="{boot_id_prefix}",
        catalog_entries=catalog_entries,
        project_target=project_target,
        rail_snapshot=rail_snapshot,
        move_rail=move_rail,
        motion_profile_ref=motion_profile_ref,
        point_set_path=point_set_path,
        joint_count=6,
    )


class {class_prefix}ArmCardMixin(RailMountedArmCardMixin):
    @action(description="读取机器人状态", always_free=True)
    def query(self) -> dict[str, JSONValue]:
        return super().query()

    @action(description="回原点")
    def home(self) -> None:
        super().home()

    @action(description="移动到活动 PointSet 锚点")
    def move_to_anchor(self, point_id: str) -> None:
        super().move_to_anchor(point_id)

    @action(description="读取 PointSet 目录与执行器观测", always_free=True)
    def read_point_catalog(self) -> dict[str, JSONValue]:
        return super().read_point_catalog()

    @action(description="读取机械臂调试卡片快照", always_free=True)
    def read_debug_snapshot(self) -> dict[str, JSONValue]:
        return super().read_debug_snapshot()

    @action(description="离散关节点动")
    def jog_joint_once(
        self,
        joint_ref: str,
        direction: str,
        step_deg: float = 1.0,
    ) -> dict[str, JSONValue]:
        return super().jog_joint_once(
            joint_ref,
            direction,
            step_deg=step_deg,
        )

    @action(description="离散工具中心点点动")
    def jog_tcp_once(
        self,
        axis: str,
        direction: str,
        step: float = 1.0,
        frame_ref: str = "arm_base",
    ) -> dict[str, JSONValue]:
        return super().jog_tcp_once(
            axis,
            direction,
            step=step,
            frame_ref=frame_ref,
        )

    @action(description="把当前关节位置写回作者 PointSet")
    def teach_point_from_current(
        self,
        target_ref: str,
        confirm: bool = False,
    ) -> dict[str, JSONValue]:
        return super().teach_point_from_current(target_ref, confirm=confirm)

    @action(description="移动导轨到绝对位置")
    def move_rail_to_position(self, position_mm: float) -> None:
        super().move_rail_to_position(position_mm)

    @action(description="记录当前机械臂与导轨位置到 PointSet v3")
    def record_current_point(
        self,
        target_ref: str,
        expected_revision: str | None = None,
        confirm: bool = False,
        include_vision: bool = False,
        marker_ref: str | None = None,
    ) -> dict[str, JSONValue]:
        return super().record_current_point(
            target_ref,
            expected_revision=expected_revision,
            confirm=confirm,
            include_vision=include_vision,
            marker_ref=marker_ref,
        )

    @action(description="登记摄像头外参标定占位结果")
    def calibrate_camera_extrinsic(self, confirm: bool = False) -> dict[str, JSONValue]:
        return super().calibrate_camera_extrinsic(confirm=confirm)

    @action(description="登记 TCP 标定占位结果")
    def calibrate_tcp(self, confirm: bool = False) -> dict[str, JSONValue]:
        return super().calibrate_tcp(confirm=confirm)

    @action(description="为指定 process_warehouse 登记 marker")
    def record_marker(
        self,
        warehouse_ref: str,
        confirm: bool = False,
    ) -> dict[str, JSONValue]:
        return super().record_marker(warehouse_ref, confirm=confirm)

    def _arm_card_context(self) -> ArmCardContext:
        return build_{device_id}_arm_card_context()

    def _point_set_resolver(self) -> object:
        return robot_point_set_resolver()


def _display_source_point(target_ref: str) -> str:
    parts = [part for part in str(target_ref).split(".") if part]
    if not parts:
        return str(target_ref).strip()
    last = parts[-1]
    if last in {"interaction_seed", "interaction", "entry"} and len(parts) >= 2:
        return parts[-2]
    return last
