"""Preview FK/IK 门面：委托 L1 EliteCs66PreviewKinematics。"""
from __future__ import annotations

from collections.abc import Sequence

from unilab_arm_elite_cs66 import EliteCs66PreviewKinematics
from unilab_robot_runtime.preview.types import ArmMount

from {domain_pkg}.devices.{device_id}.mounts import get_mount

_KIN = EliteCs66PreviewKinematics()


class {class_prefix}PreviewKinematics:
    def fk_tcp(self, mount: ArmMount, q_deg: Sequence[float], rail_y: float = 0.0):
        return _KIN.fk_tcp(mount, q_deg, rail_y)

    def ik_tcp(
        self,
        mount: ArmMount,
        xyz: Sequence[float],
        *,
        seed: Sequence[float] | None = None,
        yaw_deg: float = 0.0,
        rail_y: float = 0.0,
        orientation_xyzw: Sequence[float] | None = None,
    ):
        kwargs: dict = {"seed": seed, "yaw_deg": yaw_deg, "rail_y": rail_y}
        if orientation_xyzw is not None:
            kwargs["orientation_xyzw"] = orientation_xyzw
        return _KIN.ik_tcp(mount, xyz, **kwargs)

    def resolve_mount(self, device_id: str) -> ArmMount:
        return get_mount(device_id)
